// Schema do Lash Studio.
//
// Três regras que valem para todos os modelos:
//
// 1. **Dinheiro é `Decimal(10,2)`, nunca `Float`.** Ponto flutuante erra
//    centavos ao somar, e isto é registro financeiro.
// 2. **Datas são `@db.Date`, sem hora.** Guardar timestamp reintroduziria o
//    problema de fuso que `src/lib/periodo.js` resolveu. Mas atenção: o
//    Prisma devolve essas colunas como **meia-noite UTC**, e lê-las com os
//    getters locais erra um dia. Converta só na borda, com `isoDeDataUTC` na
//    leitura e `dataUTCDeISO` na escrita.
// 3. **Campo derivado não é coluna.** O rótulo curto (`date`) sai de
//    `diaCurto(iso)` e a categoria do gasto (`cat`) sai de `CAT_POR_SUB[sub]`
//    (`src/data/dominio.js`). Os dois nascem em `src/server/leitura.js`.

// Usamos o generator legado `prisma-client-js`, e não o `prisma-client` novo,
// porque este projeto é JavaScript: o generator novo emite TypeScript, e pedir
// outra extensão só renomeia o arquivo — o conteúdo continua TS e o Node
// quebra ao importar. O legado emite JS de verdade em node_modules/.prisma,
// consumido por `@prisma/client`, o que serve tanto ao Next quanto ao seed em
// Node puro.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  nome      String
  studio    String?
  whatsapp  String?
  senhaHash String
  criadoEm  DateTime @default(now())

  entradas     Entrada[]
  gastos       Gasto[]
  materiais    Material[]
  agendamentos Agendamento[]
  servicos     Servico[]
}

model Entrada {
  id        String   @id @default(cuid())
  userId    String
  cliente   String
  servicoId String
  metodo    String
  data      DateTime @db.Date
  valor     Decimal  @db.Decimal(10, 2)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  servico Servico @relation(fields: [servicoId], references: [id])

  // O app sempre consulta "os registros deste usuário neste mês".
  @@index([userId, data])
  // Para agrupar faturamento por serviço sem varrer a tabela.
  @@index([servicoId])
}

model Gasto {
  id      String   @id @default(cuid())
  userId  String
  titulo  String
  tipo    String // trabalho | pessoal
  subtipo String // fixo | variavel | superfluo | necessario
  data    DateTime @db.Date
  valor   Decimal  @db.Decimal(10, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, data])
}

model Material {
  id         String   @id @default(cuid())
  userId     String
  nome       String
  quantidade Int
  unidade    String
  custo      Decimal  @db.Decimal(10, 2)
  minimo     Int
  compradoEm DateTime @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, compradoEm])
}

model Agendamento {
  id        String   @id @default(cuid())
  userId    String
  cliente   String
  servicoId String
  data      DateTime @db.Date
  hora      String // "09:00"
  duracao   String // "2h30"
  status    String // Confirmado | Aguardando sinal | Concluído | Em atendimento
  valor     Decimal  @db.Decimal(10, 2)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  servico Servico @relation(fields: [servicoId], references: [id])

  @@index([userId, data])
  @@index([servicoId])
}

/// O catálogo de serviços da conta — o vocabulário é dela, não nosso.
///
/// Existe para dar autonomia sem perder análise: texto livre a cada lançamento
/// viraria "Volume russo", "volume russo" e "Vol. russo" como três serviços
/// diferentes em qualquer gráfico. Apontando para uma linha, renomear propaga
/// para todo o histórico e a contagem continua honesta.
///
/// `precoPadrao` é **sugestão**, nunca verdade: o valor cobrado fica no
/// lançamento e não é recalculado quando o padrão muda. Promoção não mexe aqui.
///
/// Serviço não se apaga, se desativa (`ativo`): sai da lista de escolha e
/// continua nos relatórios. A relação com os lançamentos é `Restrict` de
/// propósito — o banco recusa apagar um serviço que tem histórico.
model Servico {
  id            String   @id @default(cuid())
  userId        String
  nome          String
  precoPadrao   Decimal? @db.Decimal(10, 2)
  duracaoPadrao String?
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entradas     Entrada[]
  agendamentos Agendamento[]

  // Duas vezes o mesmo nome na mesma conta é erro do banco, não bug do app.
  @@unique([userId, nome])
}
