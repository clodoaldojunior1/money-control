# Copie para .env.local e preencha. O .env.local é ignorado pelo git.
#
# Nunca comite valores reais nem os cole em chat.

# String de conexão do Neon (Dashboard → Connect → Connection string).
# Use a versão "pooled" no app; para migrações o Neon aceita a mesma URL.
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"

# Conta inicial criada por `yarn db:seed`.
SEED_EMAIL="voce@studio.com"
SEED_SENHA="escolha-uma-senha-forte"

# Segredo de sessão do Auth.js (entra na Etapa 4).
# Gere com: npx auth secret
AUTH_SECRET=""
